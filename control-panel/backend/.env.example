# Backend configuration.
# Copy to backend/.env and fill in. The Gemini key is read from
# ../../extraction/.env automatically, so it does not need repeating here.

# Supabase - Project Settings > API.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Server-side key. Newer projects issue sb_secret_...; legacy ones a
# service_role JWT. Set whichever your project has - either name is read.
# This key bypasses row-level security: keep it out of the browser and out
# of version control.
SUPABASE_SECRET_KEY="sb_secret_..."
# SUPABASE_SERVICE_ROLE_KEY="legacy-service-role-jwt"

# Where the Next.js dev server runs
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Port the backend binds to. Change it if 8000 is occupied - a uvicorn process
# killed uncleanly on Windows can keep the port bound under a PID that no
# longer resolves, so it cannot be killed and only a reboot frees it. Keep
# BACKEND_URL in ../.env.local pointing at the same port.
BACKEND_PORT=8000

# The first administrator, created on the first start after migration 0006 has
# run and only while the profiles table is completely empty. Change the
# password from the User Access screen once you have signed in.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin123

# Where the project publishes the keys that sign access tokens. Derived from
# SUPABASE_URL when omitted.
# SUPABASE_JWKS_URL="https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json"
