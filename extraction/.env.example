# ==============================================================================
# COMMERCIAL REAL ESTATE EXTRACTION MODULE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Server Settings
APP_NAME="Commercial Real Estate Data Extraction Engine"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"

# Data File Paths
DATA_DIR="./BLR_Builders_Developers_Supply"
OUTPUT_CSV_PATH="./centralized_database.csv"
OUTPUT_EXCEL_PATH="./centralized_database.xlsx"
AUDIT_CSV_PATH="./file_coverage_audit.csv"

# Default AI Provider (gemini | openai | claude)
DEFAULT_AI_PROVIDER="gemini"

# ------------------------------------------------------------------------------
# GOOGLE GEMINI API CONFIGURATION
# Compatible with Gemini 2.5 Flash, Gemini 2.5 Pro, Gemini 1.5 Flash
# Get key: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# OPENAI API CONFIGURATION
# Compatible with GPT-4o, GPT-4o-mini, GPT-3.5-turbo
# Get key: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# ANTHROPIC CLAUDE API CONFIGURATION
# Compatible with Claude 3.5 Sonnet, Claude 3 Opus, Claude 3 Haiku
# Get key: https://console.anthropic.com/
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-sonnet-20241022"
